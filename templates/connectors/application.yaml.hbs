http:
  port: ${http.port}

api:
  name: {{apiName}}
  version: {{apiVersion}}

{{#if hasSnowflake}}
snowflake:
  account: ${snowflake.account}
  warehouse: ${snowflake.warehouse}
  database: ${snowflake.database}
  schema: ${snowflake.schema}
  user: ${snowflake.user}
  password: ${snowflake.password}
{{/if}}

{{#if hasIbmMq}}
ibmmq:
  host: ${ibmmq.host}
  port: ${ibmmq.port}
  queueManager: ${ibmmq.queueManager}
  channel: ${ibmmq.channel}
  username: ${ibmmq.username}
  password: ${ibmmq.password}
{{/if}}

{{#if hasAnypointMq}}
anypointmq:
  url: ${anypointmq.url}
  clientId: ${anypointmq.clientId}
  clientSecret: ${anypointmq.clientSecret}
{{/if}}

{{#if hasDatabase}}
database:
  url: ${db.url}
  user: ${db.user}
  password: ${db.password}
{{/if}}

{{#if hasSftp}}
sftp:
  host: ${sftp.host}
  port: ${sftp.port}
  user: ${sftp.user}
  password: ${sftp.password}
{{/if}}
