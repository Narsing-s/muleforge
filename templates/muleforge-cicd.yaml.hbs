deployment:
  provider: cloudhub2
  defaults:
    region: us-east-1
    runtime: 4.9.0
    applicationName: {{artifactId}}-dev
    workers: 1
    workerSize: 0.1
  regions:
    - us-east-1
    - us-east-2
    - us-west-1
    - eu-west-1
    - ap-southeast-1
  runtimes:
    - 4.9.0
    - 4.8.0
  environments:
    development:
      githubEnvironment: development
